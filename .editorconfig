root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,md,json,jsonl,yml,yaml,toml,ini,cfg,xml,txt,csv,env}]
end_of_line = lf

[.env]
end_of_line = lf

[*.{bat,ps1}]
end_of_line = crlf

[*.py]
indent_style = space
indent_size = 4

[*.md]
# Keep Markdown hard line breaks if used.
trim_trailing_whitespace = false
