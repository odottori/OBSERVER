# -----------------------------------------------------------------------------
# NEWS-ALPHA — .gitignore (repo hardening)
# Scopo: evitare che finiscano in Git artefatti locali (cache, log, output,
#        venv, DB temporanei, file di configurazione/segreti locali, ecc.).
# -----------------------------------------------------------------------------

# --- Python: bytecode / cache ----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Virtual environments ---------------------------------------------------
.venv/
venv/
ENV/
env/
.python-version

# --- Packaging / build ------------------------------------------------------
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.whl

# --- Test / coverage --------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
*.py,cover
.tox/
.nox/
.hypothesis/
pytestdebug.log
junit*.xml

# --- Linters / type checkers ------------------------------------------------
.mypy_cache/
.pytype/
.pyre/
.ruff_cache/

# --- Notebooks --------------------------------------------------------------
.ipynb_checkpoints/

# --- Logs / runtime output --------------------------------------------------
*.log
logs/
log/

# --- Local config / secrets -------------------------------------------------
.env
.env.*
!.env.example
.envrc
.direnv/
*.local.env
*.local.ps1
*.local.json
*.local.yml
*.local.yaml
config/*.local.*
.streamlit/secrets.toml

# --- OS / editor / IDE ------------------------------------------------------
.vscode/
.idea/
.history/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Tooling caches ---------------------------------------------------------
.cache/
.cache-*/
.pip-cache/
pip-log.txt
.pip/
__pypackages__/

# --- Node / frontend (se presente) -----------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Archives / artifacts ---------------------------------------------------
*.zip
*.tar
*.gz
*.rar
*.7z

# --- Databases / data artifacts --------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.duckdb
*.duckdb.wal
*.duckdb.tmp
/data/
!/data/.gitkeep
!/data/README.md

# --- Generated reports / exports -------------------------------------------
/reports/
!/reports/.gitkeep
!/reports/README.md

# --- Backups / temporary directories ---------------------------------------
*.tmp
*.temp
*.bak
*.orig
*.rej
_backup*/
backup*/
/tmp/
/temp/
/out/
/output/
/artifacts/

# --- If these exist, never ignore them (canonical / rules) ------------------
!.doc/
!.doc/**
!.rules/
!.rules/**

# --- Test fixtures: devono restare committabili anche se matchano pattern ---
!test/fixtures/**
